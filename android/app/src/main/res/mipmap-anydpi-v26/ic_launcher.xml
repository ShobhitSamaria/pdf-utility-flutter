<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). The background is the logo's own
     navy; the foreground is the supplied logo artwork, kept inside the 66/108
     safe zone. The monochrome layer is used by Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
